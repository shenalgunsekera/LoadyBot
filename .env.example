# ── Database (one Postgres, shared schema, RLS-isolated per account) ──────────
# Any REAL Postgres works (RLS is the isolation backbone — don't use Cockroach/
# PlanetScale/Turso). Supabase free tier is a great fit and RLS-native.
# Supabase: use the "Transaction pooler" connection string (port 6543). Our
# tenant context uses SET LOCAL inside a transaction, which the pooler supports.
DATABASE_URL=postgres://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# ── Web dashboard ────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string
# Passwordless magic-link email (any SMTP or a provider like Resend/Postmark)
EMAIL_FROM=Loady <noreply@loady.app>
RESEND_API_KEY=

# ── Stripe (subscription billing) ────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── The one shared Telegram bot ("Loady") ────────────────────────────────────
TELEGRAM_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ── The one shared Discord bot ("Loady") ─────────────────────────────────────
DISCORD_TOKEN=
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
# OAuth2 for the one-click "Add to Server" connect flow
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Receipt storage (object storage — cheap; images never touch Postgres) ─────
STORAGE_BUCKET=
STORAGE_KEY=
