# ── Database (one Neon project, shared schema, RLS-isolated per account) ──────
DATABASE_URL=postgres://user:pass@ep-xxx.neon.tech/loady?sslmode=require

# ── Web dashboard ────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string
# Passwordless magic-link email (any SMTP or a provider like Resend/Postmark)
EMAIL_FROM=Loady <noreply@loady.app>
RESEND_API_KEY=

# ── Stripe (subscription billing) ────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── The one shared Telegram bot ("Loady") ────────────────────────────────────
TELEGRAM_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ── The one shared Discord bot ("Loady") ─────────────────────────────────────
DISCORD_TOKEN=
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
# OAuth2 for the one-click "Add to Server" connect flow
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Receipt storage (object storage — cheap; images never touch Postgres) ─────
STORAGE_BUCKET=
STORAGE_KEY=
